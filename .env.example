# Copy this file to .env and fill in the secrets. .env is gitignored; this file is not.
# Read by `docker compose` (docker-compose.yml takes every setting from here, with the
# same defaults shown below) and by the API when you run it from EventHub.API/
# (Program.cs loads ../.env). Lines that start with # are optional: remove the # to change them.

# --- Secrets: make your own, never reuse these examples -----------------------------
# With docker compose these four are NOT read from here: they live in Secrets Manager (Floci), created from
# infra/terraform.tfvars (see README: Run locally). Fill them in here only to run the API from the IDE
# without Secrets Manager, and then leave Aws__SecretId out.
# Signs access tokens. Use at least 32 random bytes:  openssl rand -base64 48
Jwt__Key=change-me-use-openssl-rand-base64-48
# Signs the QR codes on tickets. Keep it different from Jwt__Key:  openssl rand -base64 48
Tickets__Secret=change-me-use-openssl-rand-base64-48

# --- Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys) -----------
Stripe__SecretKey=sk_test_your_key_here
# From `stripe listen --forward-to localhost:8080/webhooks/stripe`
Stripe__WebhookSecret=whsec_your_secret_here

# --- Database (docker compose) -------------------------------------------------------
# The Postgres container is created with these; the API's connection string is built from them.
# The data volume keeps the password it was first created with: changing POSTGRES_PASSWORD
# later does not change it. Run `docker compose down -v` (this DELETES the data) to start over.
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub_dev
POSTGRES_DB=eventhub
# Use a different database server instead (replaces the connection string built above):
# DB_CONNECTION=Host=postgres;Port=5432;Database=eventhub;Username=eventhub;Password=eventhub_dev

# --- Event images (S3). Used by docker compose and by the API run from the IDE ----------
# Defaults point at Floci, the local AWS emulator started by `docker compose up`
# (see README: Event images and CORS). If you change FLOCI_PORT below, change these too.
S3__ServiceUrl=http://localhost.floci.io:4566
S3__Bucket=eventhub-images
# Saved into every event's imageUrl: use an address your clients can reach (a phone cannot reach localhost).
S3__PublicBaseUrl=http://localhost.floci.io:4566/eventhub-images
# Floci accepts any credentials; the AWS SDK reads these three itself.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# --- Optional: read the secrets above from AWS Secrets Manager instead (see infra/) ---
# Set the secret's name and the API fetches Jwt:Key, Tickets:Secret and the Stripe keys from it at startup;
# they win over the values in this file, which can then stay empty. Aws__ServiceUrl is Floci when running
# outside Docker (compose uses http://floci:4566 itself); leave it empty for real AWS.
# Aws__SecretId=eventhub/app
# Aws__ServiceUrl=http://localhost:4566

# --- Optional: send emails through an SQS queue (created by infra/sqs.tf) ---
# Set the queue's name and the API only queues each email; a background worker sends it, with retries.
# Aws__ServiceUrl (above) must point at Floci when running outside Docker. Leave empty to send inside the request.
# Sqs__EmailQueue=eventhub-email
# Retry queues: a Stripe stop/refund that failed, and a poster that could not be deleted, are tried again. Empty: not queued.
# Sqs__PaymentRetryQueue=eventhub-payment-retry
# Sqs__FileDeleteQueue=eventhub-file-delete

# --- CORS: origins allowed to call the API from a browser (comma separated) ---------
Cors__AllowedOrigins=http://localhost:5173

# --- Optional: behind a reverse proxy (nginx, a load balancer) -------------------------
# Without this every user shares the proxy's IP, so one rate-limit bucket. List the proxy's address
# (or its network, CIDR) so X-Forwarded-For is trusted from there and nowhere else. Loopback is always trusted.
# ForwardedHeaders__KnownProxies=10.0.0.5
# ForwardedHeaders__KnownNetworks=172.18.0.0/16

# --- Optional: Swagger UI at /swagger. Compose turns it on by default; the IDE's launch profile does too ---
# Swagger__Enabled=true

# --- Optional: tokens (docker compose defaults shown) --------------------------------
# Jwt__Issuer=EventHub
# Jwt__Audience=EventHubUsers
# Jwt__ExpiryMinutes=15
# Jwt__RefreshTokenDays=30

# --- Optional: email (docker compose defaults to the Mailpit container; inbox on port 8025) ---
# Point these at a real SMTP server to send real mail. An empty Smtp__Host only logs the emails.
# Smtp__Host=mailpit
# Smtp__Port=1025
# Smtp__From=Event Hub <no-reply@eventhub.local>
# Smtp__User=
# Smtp__Password=

# --- Optional: ports on your machine, if a default is already taken ------------------
# API_PORT=8080
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025
# FLOCI_PORT=4566
